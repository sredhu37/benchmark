# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Regional Worker URLs
# For local development, use different ports
ASIA_WORKER_URL=http://localhost:5001
EUROPE_WORKER_URL=http://localhost:5002
US_WORKER_URL=http://localhost:5003

# For production, use Cloud Run URLs
# ASIA_WORKER_URL=https://benchmark-worker-asia-xyz.run.app
# EUROPE_WORKER_URL=https://benchmark-worker-europe-xyz.run.app
# US_WORKER_URL=https://benchmark-worker-us-xyz.run.app

# Benchmark Configuration
REQUEST_TIMEOUT=10000
MAX_URLS=5
DEFAULT_DURATION=30
MIN_DURATION=10
MAX_DURATION=60

# Worker Configuration (set this on each regional worker)
REGION=orchestrator
# For workers, set to: asia, europe, or us
